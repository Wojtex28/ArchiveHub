# Skopiuj do pliku .env i uzupełnij. Plik .env NIGDY nie trafia do repozytorium.

# 1 = tryb deweloperski (lokalnie), 0 = produkcja
DJANGO_DEBUG=1

# Długi losowy ciąg. Wygeneruj np.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Domena archiwum (produkcja), np. archiwum.twojadomena.pl
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Pełny adres z https://, np. https://archiwum.twojadomena.pl
DJANGO_CSRF_TRUSTED_ORIGINS=

ARCHIVEHUB_SITE_TITLE=Skany fotografii Włodyka/Bereza
ARCHIVEHUB_LOG_LEVEL=INFO

# Adres awaryjnego panelu Django (z ukośnikiem na końcu)
ARCHIVEHUB_DJANGO_ADMIN_PATH=zaplecze/

# Port na komputerze/serwerze, pod którym działa Caddy (tylko 127.0.0.1)
ARCHIVEHUB_HTTP_PORT=8080

# Limit pamięci RAM dla aplikacji (Docker), np. 768m albo 1g
ARCHIVEHUB_APP_MEMORY=768m

# Import albumów: folder na serwerze (udział SMB), z którego worker czyta nowe albumy.
# Na TrueNAS np. /mnt/NASTest/ArchiveImport. Domyślnie ./import obok compose.yaml.
ARCHIVEHUB_IMPORT_PATH=./import
# Folder trafia do importu, gdy przez tyle minut nic się w nim nie zmienia.
ARCHIVEHUB_IMPORT_STABLE_MINUTES=10
# Końcówka nazwy pliku z rewersem: 012.jpg + 012_r.jpg
ARCHIVEHUB_REVERSE_SUFFIX=_r
# Limit pamięci RAM dla workera importu
ARCHIVEHUB_WORKER_MEMORY=1g

# Token tunelu z panelu Cloudflare (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
