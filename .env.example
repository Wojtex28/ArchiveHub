# Skopiuj do pliku .env i uzupełnij. Plik .env NIGDY nie trafia do repozytorium.

# 1 = tryb deweloperski (lokalnie), 0 = produkcja
DJANGO_DEBUG=1

# Długi losowy ciąg. Wygeneruj np.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Domena archiwum (produkcja), np. archiwum.twojadomena.pl
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Pełny adres z https://, np. https://archiwum.twojadomena.pl
DJANGO_CSRF_TRUSTED_ORIGINS=

ARCHIVEHUB_SITE_TITLE=Skany fotografii Włodyka/Bereza
ARCHIVEHUB_LOG_LEVEL=INFO

# Adres awaryjnego panelu Django (z ukośnikiem na końcu)
ARCHIVEHUB_DJANGO_ADMIN_PATH=zaplecze/

# Port na komputerze/serwerze, pod którym działa Caddy (tylko 127.0.0.1)
ARCHIVEHUB_HTTP_PORT=8080

# Token tunelu z panelu Cloudflare (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
