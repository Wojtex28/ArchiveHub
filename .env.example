# Skopiuj do pliku .env i uzupełnij. Plik .env NIGDY nie trafia do repozytorium.

# 1 = tryb deweloperski (lokalnie), 0 = produkcja
DJANGO_DEBUG=1

# Długi losowy ciąg. Wygeneruj np.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Domena archiwum (produkcja), np. archiwum.twojadomena.pl
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Pełny adres z https://, np. https://archiwum.twojadomena.pl
DJANGO_CSRF_TRUSTED_ORIGINS=

ARCHIVEHUB_SITE_TITLE=Skany fotografii Włodyka/Bereza
ARCHIVEHUB_LOG_LEVEL=INFO

# Adres awaryjnego panelu Django (z ukośnikiem na końcu)
ARCHIVEHUB_DJANGO_ADMIN_PATH=zaplecze/

# Port na komputerze/serwerze, pod którym działa Caddy (tylko 127.0.0.1)
ARCHIVEHUB_HTTP_PORT=8080

# Limit pamięci RAM dla aplikacji (Docker), np. 768m albo 1g
ARCHIVEHUB_APP_MEMORY=768m

# Import albumów: folder na serwerze (udział SMB), z którego worker czyta nowe albumy.
# Na TrueNAS np. /mnt/NASTest/ArchiveImport. Domyślnie ./import obok compose.yaml.
ARCHIVEHUB_IMPORT_PATH=./import
# Folder trafia do importu, gdy przez tyle minut nic się w nim nie zmienia.
ARCHIVEHUB_IMPORT_STABLE_MINUTES=10
# Końcówka nazwy pliku z rewersem: 012.jpg + 012_r.jpg
ARCHIVEHUB_REVERSE_SUFFIX=_r
# Po tylu sekundach od ostatniego obrócenia zdjęcia w galerii worker obraca jego pliki
ARCHIVEHUB_ROTATION_DELAY_SECONDS=30
# Tyle ZIP-ów (zaznaczone zdjęcia, cały album) może się pobierać naraz; kolejne osoby proszone są o chwilę cierpliwości
ARCHIVEHUB_MAX_ZIP_DOWNLOADS=3
# Limit pamięci RAM dla workera importu (skan 100 Mpx potrzebuje ok. 650 MB)
ARCHIVEHUB_WORKER_MEMORY=1g
# Oryginał do pobrania: jakość JPEG i dłuższy bok w px (0 = pełna rozdzielczość skanu)
ARCHIVEHUB_ORIGINAL_QUALITY=92
ARCHIVEHUB_ORIGINAL_MAX_SIDE=0
# Podgląd na ekranie (dłuższy bok w px)
ARCHIVEHUB_PREVIEW_MAX_SIDE=2560

# Token tunelu z panelu Cloudflare (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# Kopie zapasowe bazy: folder na serwerze (np. /mnt/NASTest/ArchiveHub/kopie). Domyślnie ./kopie obok compose.yaml.
ARCHIVEHUB_BACKUP_PATH=./kopie
# Kopia raz na dobę po tej godzinie; rotacja: tyle ostatnich dni i miesięcy
ARCHIVEHUB_BACKUP_HOUR=3
ARCHIVEHUB_BACKUP_DAILY=14
ARCHIVEHUB_BACKUP_MONTHLY=12

# Konto master: logowanie dwuskładnikowe (1 = wymagane) i długość sesji w dniach
ARCHIVEHUB_MASTER_2FA=1
ARCHIVEHUB_MASTER_SESSION_DAYS=30

# Dane aplikacji (baza, albumy). Puste = wolumen Dockera; na TrueNAS zalecany dataset, np. /mnt/NASTest/ArchiveData
# (przeniesienie: README, „Dane na osobnym datasecie”)
ARCHIVEHUB_DATA_PATH=

# Klucz do adresu dla monitoringu /healthz/pelny?klucz=… (README, „Monitoring”). Pusty = wyłączone.
ARCHIVEHUB_STATUS_TOKEN=
